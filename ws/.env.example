# Bu dosyayı .env olarak kopyala ve değerleri doldur: cp .env.example .env
# .env git'e gönderilmez (.gitignore).

DB_URL=jdbc:postgresql://localhost:5433/hoaxify
DB_USERNAME=hoaxify
DB_PASSWORD=change-me

# Sadece hoaxify.token-type=jwt iken gerekir, en az 32 karakter olmalı
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Sadece dev dışındaki profillerde (SMTP ile gerçek mail gönderimi) gerekir
MAIL_USERNAME=
MAIL_PASSWORD=
